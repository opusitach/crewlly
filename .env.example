# Copy to `.env.production` on the production server (or to `.env` for local/dev if needed).
# `.env.production` is ignored by git and must not be committed.
#
# Tip: keep `COMPOSE_PROJECT_NAME` stable to preserve container/volume names between redeploys.
COMPOSE_PROJECT_NAME=myapp

# -----------------------------------------------------------------------------
# Caddy / domains / HTTP Basic Auth (hashes via `caddy hash-password --plaintext`)
# -----------------------------------------------------------------------------
CADDY_APP_DOMAIN=crewlly.com
CADDY_API_DOMAIN=api.crewlly.com
CADDY_PGADMIN_DOMAIN=pgadmin.crewlly.com
CADDY_MINIO_API_DOMAIN=minio.crewlly.com
CADDY_MINIO_CONSOLE_DOMAIN=minio-console.crewlly.com

# Use fixed usernames or change them as needed.
# IMPORTANT: Caddy hashes contain `$` characters. In `.env.production`, wrap hash values
# in single quotes, e.g. BASIC_AUTH_USER1_HASH='$2a$14$...'
# (or escape each `$` as `$$`) so docker compose does not treat them as variables.
BASIC_AUTH_USER1_NAME=ops1
BASIC_AUTH_USER1_HASH=CHANGE_ME_CADDY_HASH_1
BASIC_AUTH_USER2_NAME=ops2
BASIC_AUTH_USER2_HASH=CHANGE_ME_CADDY_HASH_2
BASIC_AUTH_USER3_NAME=ops3
BASIC_AUTH_USER3_HASH=CHANGE_ME_CADDY_HASH_3

# -----------------------------------------------------------------------------
# Postgres / pgAdmin
# -----------------------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=app
DATABASE_URL=postgresql://app:CHANGE_ME_POSTGRES_PASSWORD@db:5432/app

# Used by pgAdmin container (mapped to PGADMIN_DEFAULT_* internally in compose.data.yml)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD

# -----------------------------------------------------------------------------
# MinIO / S3-compatible storage
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
AWS_REGION=us-east-1
AWS_S3_BUCKET=crewlly-procedures
AWS_S3_ENDPOINT=http://minio:9000
# Public endpoint used by browser / presigned URLs (usually proxied by Caddy)
AWS_S3_PRESIGN_ENDPOINT=https://minio.crewlly.com
AWS_S3_PUBLIC_BASE_URL=https://minio.crewlly.com/crewlly-procedures
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_ROOT_PASSWORD

# -----------------------------------------------------------------------------
# App (front/back) runtime
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://crewlly.com
COOKIE_SECURE=true
API_PROXY_TARGET=http://back:3001
EMAIL_PROVIDER=mailpit
EMAIL_FROM="Crewlly <no-reply@crewlly.com>"
EMAIL_VERIFICATION_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025
RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY
AUDIT_LOG_ENABLED=true
INTERNAL_CRON_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET
INTERNAL_SCHEDULER_BASE_URL=http://back:3001
INTERNAL_SCHEDULER_STATE_PATH=/tmp/internal-scheduler-state.json
STALE_SHIFT_AUTO_CLOSE_INTERVAL_SECONDS=900
WORK_INTERVAL_CONSISTENCY_INTERVAL_SECONDS=900
# Optional per-job overrides for backward compatibility / manual debugging:
# STALE_SHIFT_AUTO_CLOSE_CRON_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET
# STALE_SHIFT_AUTO_CLOSE_URL=http://back:3001/api/internal/work-intervals/auto-complete
# WORK_INTERVAL_CONSISTENCY_CRON_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET
# WORK_INTERVAL_CONSISTENCY_URL=http://back:3001/api/internal/work-intervals/consistency-check

# -----------------------------------------------------------------------------
# Observability / Grafana Cloud
# -----------------------------------------------------------------------------
ALLOY_HTTP_PORT=12345
# Docker root dir on the VPS. Keep the default unless `docker info` shows another path.
DOCKER_ROOT_DIR=/var/lib/docker
# Full Loki push URL from Grafana Cloud, usually ending with /loki/api/v1/push
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
# Loki username / tenant id from the Grafana Cloud stack details
GRAFANA_CLOUD_LOKI_USERNAME=CHANGE_ME_GRAFANA_CLOUD_LOKI_USERNAME
# Access policy token with logs:write scope
GRAFANA_CLOUD_LOGS_TOKEN=CHANGE_ME_GRAFANA_CLOUD_LOGS_TOKEN
# Full Prometheus remote_write URL from Grafana Cloud, usually ending with /api/prom/push
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-XXX.grafana.net/api/prom/push
# Prometheus username / tenant id from the Grafana Cloud stack details
GRAFANA_CLOUD_PROMETHEUS_USERNAME=CHANGE_ME_GRAFANA_CLOUD_PROMETHEUS_USERNAME
# Access policy token with metrics:write scope
GRAFANA_CLOUD_METRICS_TOKEN=CHANGE_ME_GRAFANA_CLOUD_METRICS_TOKEN

# -----------------------------------------------------------------------------
# Optional compatibility notes (uncomment if migrating an existing install)
# -----------------------------------------------------------------------------
# If your old docker compose project name differs, set COMPOSE_PROJECT_NAME to the old value
# before first deploy to reuse existing named volumes (e.g. `crewlly`).
