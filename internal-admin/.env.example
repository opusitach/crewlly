# --- internal-admin (admin.crewlly.com) environment example -----------------
# Copy to .env.local for local dev, or set these in .env.production in CI/CD.

# DB shared with the main crewlly.com app — admin reads through the same Prisma client.
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Public URLs (used by the admin shell for cross-app redirects).
MAIN_APP_URL=https://crewlly.com
ADMIN_APP_URL=https://admin.crewlly.com
# Mirror of MAIN_APP_URL but exposed to the browser bundle for the logout button.
NEXT_PUBLIC_MAIN_APP_URL=https://crewlly.com

# Parent-domain session cookie. MUST be set the same way on the main app so
# both apps see the same session. Leave empty for host-only (single-host) dev.
SESSION_COOKIE_DOMAIN=.crewlly.com

# Feature flag to enable the admin container in deployments. Defaults to true
# when the container is started; toggle to disable without rebuilding.
INTERNAL_ADMIN_ENABLED=true

# Production cookie defaults: secure in HTTPS.
COOKIE_SECURE=true
