# Legacy compatibility file.
# Source of truth for current deployments is the repository root `.env.example`.
# Full env catalog and "where to get it" notes: `docs/environment.md`
#
# Public app URL used in links/invites
NEXT_PUBLIC_APP_URL=https://app.example.com

# Cookie security should stay true behind HTTPS in production
COOKIE_SECURE=true

# Public port for frontend container
APP_PORT=3000

# pgAdmin (optional UI for PostgreSQL)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password

# PostgreSQL credentials + URL used by Prisma/Next
# Change these before the first deploy. If the volume is already initialized,
# keep them in sync with existing DB credentials.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgresql://app:app@db:5432/app

# S3-compatible storage (MinIO by default)
AWS_REGION=us-east-1
AWS_S3_BUCKET=crewlly-procedures
AWS_S3_ENDPOINT=http://minio:9000
AWS_S3_PRESIGN_ENDPOINT=https://s3.example.com
AWS_S3_PUBLIC_BASE_URL=https://s3.example.com/crewlly-procedures
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=change_me_strong_secret

# MinIO bootstrap credentials/ports (if using bundled MinIO)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Frontend -> backend internal API proxy
API_PROXY_TARGET=http://backend:3001

# Internal scheduler
INTERNAL_CRON_SECRET=change_me_strong_random_secret
INTERNAL_SCHEDULER_BASE_URL=http://back:3001
INTERNAL_SCHEDULER_STATE_PATH=/tmp/internal-scheduler-state.json
STALE_SHIFT_AUTO_CLOSE_INTERVAL_SECONDS=900
WORK_INTERVAL_CONSISTENCY_INTERVAL_SECONDS=900
# Optional per-job overrides
# STALE_SHIFT_AUTO_CLOSE_CRON_SECRET=change_me_strong_random_secret
# STALE_SHIFT_AUTO_CLOSE_URL=http://back:3001/api/internal/work-intervals/auto-complete
# WORK_INTERVAL_CONSISTENCY_CRON_SECRET=change_me_strong_random_secret
# WORK_INTERVAL_CONSISTENCY_URL=http://back:3001/api/internal/work-intervals/consistency-check
