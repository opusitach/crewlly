discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

prometheus.exporter.unix "integrations_node_exporter" {
  disable_collectors = ["ipvs", "btrfs", "infiniband", "xfs", "zfs"]
  enable_collectors  = ["meminfo"]

  filesystem {
    fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|tmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
    mount_points_exclude = "^/(dev|proc|run/credentials/.+|sys|var/lib/docker/.+)($|/)"
    mount_timeout        = "5s"
  }

  netclass {
    ignored_devices = "^(veth.*|cali.*|[a-f0-9]{15}|lo)$"
  }

  netdev {
    device_exclude = "^(veth.*|cali.*|[a-f0-9]{15}|lo)$"
  }

  procfs_path = "/host/proc"
  rootfs_path = "/rootfs"
  sysfs_path  = "/host/sys"
}

discovery.relabel "integrations_node_exporter" {
  targets = prometheus.exporter.unix.integrations_node_exporter.targets

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }

  rule {
    target_label = "job"
    replacement  = "integrations/node_exporter"
  }
}

prometheus.scrape "integrations_node_exporter" {
  targets         = discovery.relabel.integrations_node_exporter.output
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.integrations_node_exporter.receiver]
}

prometheus.relabel "integrations_node_exporter" {
  rule {
    source_labels = ["__name__"]
    regex         = "node_scrape_collector_.+"
    action        = "drop"
  }

  forward_to = [prometheus.remote_write.grafana_cloud_metrics.receiver]
}

prometheus.exporter.cadvisor "integrations_cadvisor" {
  docker_host                = "unix:///rootfs/var/run/docker.sock"
  docker_only                = true
  disable_root_cgroup_stats  = true
  // Docker Engine with containerd image store (driver-type io.containerd.snapshotter.v1)
  // is currently incompatible with cAdvisor disk/filesystem layer discovery.
  // Keep container CPU/memory/network metrics and suppress broken disk/diskIO metrics.
  enabled_metrics            = ["cpu", "memory", "network", "oom_event"]
  storage_duration           = "5m"
  store_container_labels     = false
  allowlisted_container_labels = [
    "com.docker.compose.project",
    "com.docker.compose.service",
  ]
}

discovery.relabel "integrations_cadvisor" {
  targets = prometheus.exporter.cadvisor.integrations_cadvisor.targets

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }

  rule {
    target_label = "job"
    replacement  = "integrations/docker"
  }
}

prometheus.scrape "integrations_cadvisor" {
  targets         = discovery.relabel.integrations_cadvisor.output
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.integrations_cadvisor.receiver]
}

prometheus.relabel "integrations_cadvisor" {
  rule {
    source_labels = ["name"]
    regex         = "(.+)"
    target_label  = "container_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["container_label_com_docker_compose_service"]
    regex         = "(.+)"
    target_label  = "compose_service"
    replacement   = "$1"
  }

  rule {
    source_labels = ["container_label_com_docker_compose_project"]
    regex         = "(.+)"
    target_label  = "compose_project"
    replacement   = "$1"
  }

  forward_to = [prometheus.remote_write.grafana_cloud_metrics.receiver]
}

discovery.relabel "docker_logs" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "back"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  labels        = { platform = "docker", source = "audit", stack = "crewlly" }
  relabel_rules = discovery.relabel.docker_logs.rules
  forward_to    = [loki.process.crewlly.receiver]
}

loki.process "crewlly" {
  stage.json {
    drop_malformed = true

    expressions = {
      kind            = "kind",
      level           = "level",
      service         = "service",
      environment     = "environment",
      event_type      = "event_type",
      outcome         = "outcome",
      route           = "route",
      reason          = "reason",
      status          = "status",
      status_class    = "status_class",
      method          = "request.method",
      request_id      = "request.id",
      request_path    = "request.path",
      actor_user_id   = "actor.user_id",
      organization_id = "actor.organization_id",
      access_role     = "actor.access_role",
      target_type     = "target.type",
      target_id       = "target.id",
    }
  }

  stage.labels {
    values = {
      kind            = "",
      level           = "",
      service         = "",
      environment     = "",
      event_type      = "",
      outcome         = "",
      route           = "",
      method          = "",
      status_class    = "",
      compose_service = "",
    }
  }

  stage.structured_metadata {
    values = {
      reason          = "",
      status          = "",
      request_id      = "",
      request_path    = "",
      actor_user_id   = "",
      organization_id = "",
      access_role     = "",
      target_type     = "",
      target_id       = "",
    }
  }

  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USERNAME")
      password = sys.env("GRAFANA_CLOUD_LOGS_TOKEN")
    }
  }

  external_labels = {
    app = "crewlly",
  }
}

prometheus.remote_write "grafana_cloud_metrics" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROMETHEUS_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROMETHEUS_USERNAME")
      password = sys.env("GRAFANA_CLOUD_METRICS_TOKEN")
    }
  }

  external_labels = {
    app   = "crewlly",
    stack = "crewlly",
  }
}
