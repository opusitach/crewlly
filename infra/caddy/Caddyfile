(protected_basic_auth) {
  basic_auth {
    {$BASIC_AUTH_USER1_NAME} {$BASIC_AUTH_USER1_HASH}
    {$BASIC_AUTH_USER2_NAME} {$BASIC_AUTH_USER2_HASH}
    {$BASIC_AUTH_USER3_NAME} {$BASIC_AUTH_USER3_HASH}
  }
}

(protected_basic_auth_front) {
  basic_auth bcrypt CrewllyFront {
    {$BASIC_AUTH_USER1_NAME} {$BASIC_AUTH_USER1_HASH}
    {$BASIC_AUTH_USER2_NAME} {$BASIC_AUTH_USER2_HASH}
    {$BASIC_AUTH_USER3_NAME} {$BASIC_AUTH_USER3_HASH}
  }
}

# Frontend protected by HTTP Basic Auth.
{$CADDY_APP_DOMAIN} {
  import protected_basic_auth_front
  encode gzip zstd
  reverse_proxy front:3000
}

# API auth/authorization is handled by the application.
{$CADDY_API_DOMAIN} {
  encode gzip zstd

  @api path /api/*
  handle @api {
    reverse_proxy back:3001
  }

  # back is the same Next.js app and can render UI pages too.
  # Protect non-API routes so the app cannot be accessed via API domain without Basic Auth.
  handle {
    import protected_basic_auth_front
    reverse_proxy back:3001
  }
}

{$CADDY_PGADMIN_DOMAIN} {
  import protected_basic_auth
  encode gzip zstd
  reverse_proxy pgadmin:80
}

{$CADDY_MINIO_API_DOMAIN} {
  # Warning: basic auth here can break browser/mobile presigned URL flows.
  # Keep enabled only if this endpoint is admin-only or clients add Basic Auth.
  import protected_basic_auth
  reverse_proxy minio:9000
}

{$CADDY_MINIO_CONSOLE_DOMAIN} {
  import protected_basic_auth
  reverse_proxy minio:9001
}
