(protected_basic_auth) {
  basic_auth * {
    {$BASIC_AUTH_USER1_NAME} {$BASIC_AUTH_USER1_HASH}
    {$BASIC_AUTH_USER2_NAME} {$BASIC_AUTH_USER2_HASH}
    {$BASIC_AUTH_USER3_NAME} {$BASIC_AUTH_USER3_HASH}
  }
}

{$CADDY_APP_DOMAIN} {
  route {
    encode gzip zstd
    reverse_proxy front:3000
  }
}

# API auth/authorization is handled by the application.
{$CADDY_API_DOMAIN} {
  route {
    encode gzip zstd
    reverse_proxy back:3001
  }
}

{$CADDY_PGADMIN_DOMAIN} {
  import protected_basic_auth
  encode gzip zstd
  reverse_proxy pgadmin:80
}

{$CADDY_MINIO_API_DOMAIN} {
  # Do not protect S3 API with Caddy Basic Auth: browser/mobile presigned uploads
  # do not include those credentials and will fail with 401/403.
  reverse_proxy minio:9000
}

{$CADDY_MINIO_CONSOLE_DOMAIN} {
  import protected_basic_auth
  reverse_proxy minio:9001
}

# admin.crewlly.com — internal admin app. Public hostname, but the app itself
# enforces strict server-side gating (isInternal + enabled InternalGlobalAccess).
# An additional Basic Auth layer is applied at the proxy as defense-in-depth.
{$CADDY_ADMIN_DOMAIN} {
  route {
    import protected_basic_auth
    encode gzip zstd
    reverse_proxy internal_admin:3002
  }
}
